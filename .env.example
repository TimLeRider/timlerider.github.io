# Copier ce fichier vers ".env" et renseigner de vraies valeurs.
# Ne jamais commiter le fichier ".env" réel.

# Port d'écoute du serveur
PORT=3000

# "production" active les cookies "secure" (HTTPS obligatoire).
# Laisser "development" en local.
NODE_ENV=development

# Secret utilisé pour signer les cookies de session.
# Générer une valeur aléatoire forte, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_generate_a_long_random_value
